     "text": [
      "Mask shape:  (2048, 1418)\n",
      "SAM score: 0.9637522101402283\n"
     ]
    }
   ],
   "source": [
    "#Runs SAM2 on the test image using the top-ranked bounding box as a prompt.\n",
    "\n",
    "predictor.set_image(img) #This allows the predictor to preprocess the image and prepare it for inference. \n",
    "\n",
    "#take rank 1 box\n",
    "r0 = example_rows.iloc[0]\n",
    "box = np.array([[r0[\"x1\"],r0[\"y1\"],r0[\"x2\"],r0[\"y2\"]]], dtype = np.float32) #creates SAM2 box prompt \n",
    "\n",
    "#masks: binary masks predicted by SAM2 for the given box prompt, sam_scores: confidence scores for each predicted mask, _ : additional outputs that we are not using here\n",
    "masks,sam_scores, _ = predictor.predict(\n",
    "    box = box,\n",
    "    multimask_output= False #It tells SAM2 to produce one mask instead of multiple candidate masks.\n",
    ")\n",
    "\n",
    "\n",
    "# Because even with one prompt, SAM2 returns the result inside a batch-like structure. So we extract the first mask.\n",
    "masks = masks[0].astype(bool)  \n",
    "\n",
    "print(\"Mask shape: \", masks.shape)\n",
    "print(\"SAM score:\", float(sam_scores[0]) if sam_scores is not None else None)\n"
   ]
  },
