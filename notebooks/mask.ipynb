   "source": [
    "plt.figure(figsize=(10,7))\n",
    "plt.imshow(img)\n",
    "ax = plt.gca()  #get the current matplotlib axes object\n",
    "\n",
    "for _, r in example_rows.iterrows():\n",
    "    x1, y1, x2, y2 = r[\"x1\"], r[\"y1\"], r[\"x2\"], r[\"y2\"]\n",
    "    rect = patches.Rectangle((x1, y1), x2 - x1, y2 - y1, linewidth=2, fill=False)\n",
    "    ax.add_patch(rect)\n",
    "    # ax.text(x1, max(0, y1 - 5), f\"rank {int(r['rank'])}\", fontsize=10) #writes rank1 or rank2 accordingly near the box, max(0, y1 - 5) ensures the text is not drawn outside the image\n",
    "\n",
    "plt.axis(\"off\") #turns off the axis lines and labels for a cleaner look since we are only interested in the image and the boxes\n",
    "plt.show()"
   ]
  },
  {
