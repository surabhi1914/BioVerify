     "text": [
      "device: cuda\n",
      "SAM2_CFG: configs/sam2.1/sam2.1_hiera_l.yaml\n",
      "SAM2_CKPT: /rs1/researchers/a/amallav/models/sam2/checkpoints/sam2.1_hiera_large.pt\n",
      "ckpt exists: True\n"
     ]
    }
   ],
   "source": [
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "SAM2_CFG = \"configs/sam2.1/sam2.1_hiera_l.yaml\"\n",
    "SAM2_CKPT = model_dir / \"checkpoints\" / \"sam2.1_hiera_large.pt\"\n",
    "\n",
    "print(\"device:\", device)\n",
    "print(\"SAM2_CFG:\", SAM2_CFG)\n",
    "print(\"SAM2_CKPT:\", SAM2_CKPT)\n",
    "print(\"ckpt exists:\", SAM2_CKPT.exists())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "57e41d87",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SAM2 loaded ✅ | device: cuda\n"
     ]
    }
   ],
   "source": [
    "\n",
    "'''\n",
    "build_sam2:This creates the actual neural network using: config file = architecture/settings, checkpoint = learned weights, device = where model runs,mode=\"eval\" = inference mode, not training mode\n",
    "'''\n",
    "sam2_model = build_sam2(SAM2_CFG, str(SAM2_CKPT), device=device, mode=\"eval\")\n",
    "\n",
    "'''\n",
    "SAM2ImagePredictor: This is a helper class that provides an easy interface for using the SAM2 model to predict segmentation masks on images. \n",
    "It takes the loaded sam2_model as input and allows you to run inference on images with simple function calls like set_image() and predict(). \n",
    "It handles all the preprocessing and postprocessing steps needed to get segmentation masks from the raw model outputs.\n",
    "'''\n",
    "predictor = SAM2ImagePredictor(sam2_model)\n",
    "\n",
    "print(\"SAM2 loaded ✅ | device:\", device)\n"
   ]
  },
