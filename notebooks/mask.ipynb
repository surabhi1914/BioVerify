   ],
   "source": [
    "img_path = example_image\n",
    "img_pil = Image.open(img_path).convert(\"RGB\")\n",
    "img = np.array(img_pil) # converts PIL image into a NumPy array\n",
    "\n",
    "h,w = img.shape[:2] #img.shape returns (height, width, channels), we only need height and width\n",
    "print(\"Image shape:\", img.shape)\n"
   ]
