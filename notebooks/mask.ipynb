   "source": [
    "#Importing libraries\n",
    "import os \n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from PIL import Image #opening and manipulating the images\n",
    "import matplotlib.pyplot as plt #visualization of the images and the results\n",
    "import matplotlib.patches as patches #for drawing bounding boxes on the images\n",
    "import torch \n",
    "from sam2.build_sam import build_sam2 #builds the sam2 model from config and checkpoint\n",
    "from sam2.sam2_image_predictor import SAM2ImagePredictor #easy interface for image segmentation using the sam2 model\n",
    "from pathlib import Path"
