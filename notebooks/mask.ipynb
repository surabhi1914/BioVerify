   "source": [
    "\n",
    "for img_name, g in df.groupby(\"image_path\"): \n",
    "    img_path = img_name\n",
    "    if not os.path.exists(img_path):\n",
    "        print(\"[SKIP missing]\", img_path)\n",
    "        continue\n",
    "\n",
    "    img_pil = Image.open(img_path).convert(\"RGB\")\n",
    "    img_np = np.array(img_pil)\n",
    "\n",
    "    predictor.set_image(img_np)\n",
    "\n",
    "    # g = g.sort_values(\"rank\")\n",
    "    for index, r in g.iterrows():\n",
    "        box = np.array([[r[\"x1\"], r[\"y1\"], r[\"x2\"], r[\"y2\"]]], dtype=np.float32)\n",
    "        \n",
    "        '''\n",
    "        SAM2 can return multiple plausible masks for one prompt. This is useful when the box is ambiguous. So we ask SAM2 to return multiple masks and their corresponding confidence scores.\n",
    "        But since our box prompt is already clear, we ask SAM2 to return only one mask instead of multiple candidate masks.\n",
    "        With multimask_output=False, SAM2 returns a single mask, so we directly take the first one and convert it to a boolean mask.\n",
    "        '''\n",
    "        masks, sam_scores, _ = predictor.predict(box=box, multimask_output=False) \n",
    "\n",
    "        # best_idx = int(np.argmax(sam_scores)) #gives the index of the highest-scoring candidate\n",
    "        # mask = masks[best_idx].astype(bool)\n",
    "\n",
    "        mask=masks[0].astype(bool)\n",
    "\n",
    "        stem = os.path.splitext(os.path.basename(img_name))[0]\n",
    "        # rank = int(r[\"rank\"])\n",
    "        # base = f\"{stem}__r{rank}\"\n",
    "        base= f\"{stem}_{index}\" #need to check if this will work\n",
    "\n",
    "        #Binary masks should usually be saved as PNG, not JPEG. PNG supports lossless compression and preserves the exact binary values (0 and 255) needed for masks, while JPEG can introduce compression artifacts that may distort the mask edges and values.\n",
    "        mask_path = os.path.join(MASK_DIR, base + \"__mask.png\") \n",
    "        crop_path = os.path.join(CROP_DIR, base + \"__crop.png\")\n",
    "\n",
    "        save_mask_png(mask, mask_path)\n",
    "        ok = save_masked_crop_rgba(img_np, mask, box[0], crop_path)\n",
    "        if not ok:\n",
    "            # print(f\"[SKIP] Invalid crop for {img_name} rank {rank} | box: {box[0]} | image shape: {img_np.shape}\")\n",
    "            print(f\"[SKIP] Invalid crop for {img_name} | box: {box[0]} | image shape: {img_np.shape}\")\n",
    "            continue\n",
    "\n",
    "        rows_out.append({\n",
    "            \"image\": img_name,\n",
    "            # \"rank\": rank,\n",
    "            \"sam_score\": float(sam_scores[0]) if sam_scores is not None else None,\n",
    "            # \"sam_best_idx\": best_idx,\n",
    "            \"x1\": float(r[\"x1\"]),\n",
    "            \"y1\": float(r[\"y1\"]),\n",
    "            \"x2\": float(r[\"x2\"]),\n",
    "            \"y2\": float(r[\"y2\"]),\n",
    "            \"mask_path\": mask_path,\n",
    "            \"masked_crop_path\": crop_path,\n",
    "        })\n",
    "        # print(f\"Processed {img_name} rank {rank} | SAM score: {float(sam_scores[best_idx]) if sam_scores is not None else None}\")\n",
    "        print(f\"Processed {img_name} | SAM score: {float(sam_scores[0]) if sam_scores is not None else None}\")\n",
    "\n",
    "pd.DataFrame(rows_out).to_csv(meta_path, index=False)\n",
    "print(\"Done. Saved:\", meta_path)"
   ]
