   "source": [
    "#Saves a boolean mask as an image file.\n",
    "def save_mask_png(mask_bool, path):\n",
    "    mask_img = Image.fromarray((mask_bool * 255).astype(np.uint8))\n",
    "    mask_img.save(path)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "1bb92b9f-8885-447f-90ef-c32bc22fb972",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def save_masked_crop_rgba(img_rgb, mask_bool, box_xyxy, path):\n",
    "    h, w = img_rgb.shape[:2]\n",
    "\n",
    "    x0, y0, x1, y1 = box_xyxy\n",
    "    # We are taking floor for x0/y0 and ceil for x1/y1 because we want to avoid cutting off the object. So, start a little earlier and end a little later. SAFE WAY\n",
    "    x0 = max(0, min(int(np.floor(x0)), w))\n",
    "    y0 = max(0, min(int(np.floor(y0)), h))\n",
    "    x1 = max(0, min(int(np.ceil(x1)), w))\n",
    "    y1 = max(0, min(int(np.ceil(y1)), h))\n",
    "\n",
    "    if x1 <= x0 or y1 <= y0: #just an extra check : If width or height is zero/negative, it is an invalid crop.\n",
    "        return False\n",
    "\n",
    "    crop_rgb = img_rgb[y0:y1, x0:x1] #Important NumPy slicing order: rows first = y and columns second = x\n",
    "    crop_mask = mask_bool[y0:y1, x0:x1]\n",
    "\n",
    "    if crop_rgb.size == 0 or crop_mask.size == 0:\n",
    "        return False\n",
    "\n",
    "    #This creates a new 4-channel image: first 3 channels = original RGB crop and 4th channel = mask as transparency.\n",
    "    # The segmented object stays visible, while non-object regions become transparent.\n",
    "    rgba = np.zeros((crop_rgb.shape[0], crop_rgb.shape[1], 4), dtype=np.uint8)\n",
    "    rgba[:, :, :3] = crop_rgb\n",
    "    rgba[:, :, 3] = crop_mask.astype(np.uint8) * 255\n",
    "\n",
    "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
    "    Image.fromarray(rgba).save(path)\n",
    "    return True"
   ]
  },
